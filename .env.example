# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
PORT=3000

# MongoDB connection string (local Docker: docker run -d --name novatrend-mongo -p 27017:27017 mongo:7)
MONGODB_URI=mongodb://127.0.0.1:27017/novatrend

# JWT signing secret - generate with: node -e "console.log(crypto.randomUUID())"
JWT_SECRET=
JWT_EXPIRES_IN=1h
